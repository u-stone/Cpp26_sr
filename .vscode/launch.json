{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current Lab",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/clang-p2996-debug/${relativeFileDirnameBasename}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/.toolchain/clang-p2996/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build Current Lab",
            "osx": {
                "MIMode": "lldb"
            }
        },
        {
            "name": "Debug Selected Target (CMake Tools)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DYLD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/.toolchain/clang-p2996/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        }
    ]
}
